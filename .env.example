# FOOTBALL environment configuration.
# Copy to .env and fill in values. NEVER commit .env — it is gitignored.

# Data provider selection: "football-data" (default) or "bsd"
DATA_PROVIDER=football-data

# football-data.org API key (free: https://www.football-data.org/client/register)
FOOTBALL_DATA_ORG_KEY=your_football_data_org_key_here

# BSD API key (optional — only if DATA_PROVIDER=bsd; https://sports.bzzoiro.com/register/)
BSD_API_KEY=your_bsd_api_key_here

# Set to 1 (or true/yes/on) to force an OFFLINE session: startup skips all
# provider scraping and serves the last validated stored data (snapshot
# mode). Leave unset/empty/0 for the default: fresh acquisition is attempted
# lazily on the first data request for each competition in web mode (server
# boot performs zero provider calls), with fallback to stored data on
# failure.
FOOTBALL_SNAPSHOT=

# Set to 1 to optionallly restore EAGER preloading: the server lifespan
# refreshes and warms all competitions' data at boot instead of lazily on
# first request. Leave unset for the default lazy behavior.
FOOTBALL_PRELOAD_ALL=

# Polling interval (seconds) for the World Cup live-ingestion poller.
# Defaults to 60 when unset.
POLL_INTERVAL=

# Safety guard for the UCL CLI live-ingestion path: set to 1 to confirm
# intentional live ingestion into the real repository data directory. The CLI
# refuses to write live data without it.
FOOTBALL_LIVE=
