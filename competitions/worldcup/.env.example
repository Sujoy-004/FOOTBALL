# Data provider selection: "football-data" (default) or "bsd"
DATA_PROVIDER=football-data

# football-data.org API key (free, instant: https://www.football-data.org/client/register)
FOOTBALL_DATA_ORG_KEY=your_football_data_org_key_here

# BSD API key (optional — only if DATA_PROVIDER=bsd)
# Get a free key at https://sports.bzzoiro.com/register/
# BSD_API_KEY=your_bsd_api_key_here
